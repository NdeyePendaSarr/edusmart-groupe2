# =============================================================================
# .env.example
# Copier ce fichier en .env et adapter les valeurs a votre environnement
# NE JAMAIS commit le fichier .env dans Git (il contient des secrets)
# =============================================================================

# Serveur MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Identifiants (a adapter)
MYSQL_USER=edusmart_user
MYSQL_PASSWORD=change_me_with_your_password

# Base de donnees
MYSQL_DATABASE=edusmart_learning_v2
